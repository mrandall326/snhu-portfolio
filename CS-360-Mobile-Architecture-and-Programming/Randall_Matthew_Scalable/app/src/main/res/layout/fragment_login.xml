<!--
    LOGIN SCREEN

    Layout, top to bottom, follows the order a person actually signs in:
      1. Brand group: logo, app name, and a one-line tagline, so the user knows where they are.
      2. Credentials group: username, then password. These two fields sit close together because
         they are filled in as one step.
      3. Message line: one place where any problem is explained, hidden until it is needed,
         such as a username and password that don't match, a username that is already taken,
         or a new password that is too short.
      4. Primary action: Sign in, a filled button, the most prominent control on the screen.
      5. Secondary action: Create account, an outlined button under a short prompt, set apart by
         extra space so a returning user never mistakes it for the main path.

    Focus order matches that sequence. The keyboard's Next key moves from username to password,
    and the Done key on the password field signs in, so the user never has to reach for the screen.
    The whole screen scrolls, so nothing is cut off when the keyboard is open or on a small phone.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".LoginFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="48dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/screen_margin">

        <!-- 1. Brand group -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:contentDescription="@string/logo_description"
            android:src="@drawable/ic_scalable_logo" />

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tight_gap"
            android:gravity="center"
            android:text="@string/login_tagline"
            android:textAppearance="@style/TextAppearance.Scalable.Supporting" />

        <!-- 2. Credentials group -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/username_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:hint="@string/login_username"
            app:startIconContentDescription="@string/login_username"
            app:startIconDrawable="@drawable/ic_person">

            <!-- actionNext + nextFocusDown send the cursor straight to the password field. -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/username_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1"
                android:nextFocusDown="@id/password_input" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--
            Password field. inputType="textPassword" is what turns every typed character into a dot.
            The password_toggle end icon lets the user briefly reveal what they typed if they think
            they made a mistake; it starts hidden every time the screen opens.
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/password_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap"
            android:hint="@string/login_password"
            app:endIconMode="password_toggle"
            app:startIconContentDescription="@string/login_password"
            app:startIconDrawable="@drawable/ic_lock">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:nextFocusDown="@id/sign_in_button" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 3. Message line. Hidden until there is something to say, so it never adds clutter. -->
        <TextView
            android:id="@+id/login_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="That username and password do not match."
            tools:visibility="visible" />

        <!--
            4. Primary action. It starts disabled and only turns on once both fields have text,
            so it can never be pressed with an empty username or password.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sign_in_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/group_gap"
            android:enabled="false"
            android:minHeight="56dp"
            android:nextFocusDown="@id/create_account_button"
            android:text="@string/login_sign_in" />

        <!-- 5. Secondary action, separated by extra space and a short prompt. -->
        <TextView
            android:id="@+id/new_user_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/login_new_user_prompt"
            android:textAppearance="@style/TextAppearance.Scalable.Supporting" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/create_account_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tight_gap"
            android:enabled="false"
            android:minHeight="56dp"
            android:text="@string/login_create_account" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
