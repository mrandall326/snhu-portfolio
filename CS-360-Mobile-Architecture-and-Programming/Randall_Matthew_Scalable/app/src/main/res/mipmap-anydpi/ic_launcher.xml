<!--
    The app's standard launcher icon. The teal background and the white scale foreground are separate
    layers so the launcher can crop the background to its own shape and animate the two layers
    independently. The foreground doubles as the monochrome layer for themed home screens.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
