<!--
    Launcher icon foreground: the same bathroom scale as ic_scalable_logo.xml, drawn in white so it
    stands out on the teal background. The logo's 24-unit drawing is doubled in size and centered,
    which keeps it inside the middle area every launcher shape leaves uncropped.

    The dial window and the foot pads are cut out of the body as holes instead of being painted a
    second color, so the teal background shows through them. That also lets this same drawing work
    as the monochrome icon for themed home screens, where Android colors every solid part of the
    icon one shade.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2"
        android:scaleY="2"
        android:translateX="30"
        android:translateY="30">
        <!-- Body of the scale, with the dial window and the two foot pads cut out of it. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M6,3h12a3,3 0,0 1,3 3v12a3,3 0,0 1,-3 3H6a3,3 0,0 1,-3 -3V6a3,3 0,0 1,3 -3zM7,11a5,5 0,0 1,10 0zM7.5,16.5h3v1.5h-3zM13.5,16.5h3v1.5h-3z" />
        <!-- Needle inside the dial window, pointing just past center. -->
        <path
            android:pathData="M12,11L14.2,7.6"
            android:strokeWidth="1.2"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />
    </group>
</vector>
